# Local automation and virtual environments
environment/
.venv/
venv/
env/
*.tmp
*.temp
*.log
tmp/
temp/
scripts/tmp/

# OS and editor metadata
.DS_Store
Thumbs.db
desktop.ini
~$*

# Python cache
__pycache__/
*.py[cod]

# Publication assets must use neutral coded names only
img/*
!img/
!img/p*_img_*.png
!img/p*_img_*.jpg
!img/p*_img_*.jpeg
!img/p*_img_*.webp

videos/*
!videos/
!videos/p*_vid_*.mp4
# Node or tooling artifacts, if preview tooling is added later
node_modules/
.cache/
.parcel-cache/
dist/
build/

# Local IDE settings
.idea/
.vscode/
